{
  "opencollection": "1.0.0",
  "info": {
    "name": "Google Gemini Embeddings Generation API",
    "version": "v1beta"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "key",
      "value": "{{key}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Generation",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Generate content",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://generativelanguage.googleapis.com/v1beta/models/:model:generateContent",
            "params": [
              {
                "name": "model",
                "value": "",
                "type": "path",
                "description": "Model identifier (e.g. \"gemini-1.5-pro\")"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Generate content"
        },
        {
          "info": {
            "name": "Stream generated content",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://generativelanguage.googleapis.com/v1beta/models/:model:streamGenerateContent",
            "params": [
              {
                "name": "model",
                "value": "",
                "type": "path",
                "description": "Model identifier (e.g. \"gemini-1.5-pro\")"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Stream generated content"
        }
      ]
    }
  ],
  "bundled": true
}